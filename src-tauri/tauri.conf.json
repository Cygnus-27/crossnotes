{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossNotes",
  "version": "0.1.0",
  "identifier": "com.cygnus.crossnotes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrossNotes",
        "width": 1000,
        "height": 700,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Office",
    "copyright": "Copyright © 2026 Cygnus",
    "publisher": "Cygnus"
  }
}
