{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fluqsr",
  "version": "0.1.0",
  "identifier": "com.cygnus.fluqsr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "fluqsr",
        "width": 940,
        "height": 680,
        "minWidth": 520,
        "minHeight": 480,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "Copyright © 2026",
    "publisher": "Cygnus",
    "shortDescription": "Send any file to any device on your network.",
    "longDescription": "fluqsr moves files between your devices over the local network. Peer-to-peer, end-to-end encrypted, no account and no cloud. Any file type, any size."
  }
}
